{
    "name": "hampel/sparkpost-transport",
    "description": "A Symfony Mailer transport for SparkPost, built on hampel/sparkpost",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/sparkpost-transport/issues",
        "source": "https://github.com/hampel/sparkpost-transport"
    },
    "keywords": [
        "sparkpost",
        "email",
        "symfony",
        "mailer",
        "transport"
    ],
    "homepage": "https://github.com/hampel/sparkpost-transport",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "hampel/sparkpost": "^0.3.0",
        "psr/event-dispatcher": "^1",
        "psr/log": "^1|^2|^3",
        "symfony/event-dispatcher": "^5.4|^6.4|^7.0",
        "symfony/mailer": "^5.4|^6.4|^7.0",
        "symfony/mime": "^5.4|^6.4|^7.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "hampel/rig": "^1.1",
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.1.22",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\SparkPost\\Transport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\SparkPost\\Transport\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
