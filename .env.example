# A SparkPost API key with the "Transmissions: Read/Write" permission.
SPARKPOST_API_KEY=

# Where the test message goes.
SPARKPOST_TO=you@example.com

# Who it comes from. This must be a verified sending domain on the account.
#
# sparkpostbox.com is SparkPost's sandbox domain: no verified domain of your own, but only
# a handful of messages, and the transmission needs the sandbox option - send.php sets it
# whenever the From is on that domain. The sandbox domain is not enabled on every account.
# If you get "Unconfigured Sending Domain <sparkpostbox.com>" back, yours is one of those,
# and a verified domain of your own is the only way to run this.
SPARKPOST_FROM=test@sparkpostbox.com

# Optional. The envelope FROM - where bounces are delivered, and the domain SPF is checked
# against. Leave it empty and SparkPost uses the account's own bounce domain.
#
# Set it to exercise a custom bounce domain. Note that SparkPost accepting the
# transmission tells you nothing about that domain - an unverified one is accepted just
# the same, so the verdict comes from the delivered message. For DMARC to pass on SPF, the
# domain also has to align with the header From in SPARKPOST_FROM - so bounces@example.com
# against a From of noreply@example.com aligns, and the same address against a From on
# another domain authenticates but does not align.
#
# send.php sets it with SparkPostEmail::setSparkPostReturnPath(), which is the
# transmission field. Email::returnPath() is a different thing - it sets the MIME header -
# and setting that one instead leaves the account's default bounce domain on the envelope.
SPARKPOST_RETURN_PATH=

# Optional. Set to eu for the EU tenancy.
SPARKPOST_REGION=

# Set to 1 to route everything through SparkPost's sink instead of delivering it.
SPARKPOST_SINK=
