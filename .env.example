# A SparkPost API key with the "Transmissions: Read/Write" permission.
SPARKPOST_API_KEY=

# Where the test message goes.
SPARKPOST_TO=you@example.com

# Who it comes from. This must be a verified sending domain on the account.
#
# sparkpostbox.com is SparkPost's sandbox domain: no verified domain of your own, but only
# a handful of messages, and the transmission needs the sandbox option - send.php sets it
# whenever the From is on that domain. The sandbox domain is not enabled on every account.
# If you get "Unconfigured Sending Domain <sparkpostbox.com>" back, yours is one of those,
# and a verified domain of your own is the only way to run this.
SPARKPOST_FROM=test@sparkpostbox.com

# Optional. The envelope FROM - where bounces are delivered, and the domain SPF is checked
# against. Leave it empty and SparkPost uses the account's default bounce domain, or the
# subaccount's for a subaccount key, or sparkpostmail.com where neither is configured.
#
# Set it to exercise a custom bounce domain. SparkPost polices the From and not this one:
# a From outside your configured sending domains is refused at the API with
# HTTP 400 "Unconfigured Sending Domain <domain>", while the return path is not checked at
# all. So a 200 means the payload was well formed and nothing more.
#
# Two things the delivered header shows and the payload cannot. Only the DOMAIN survives -
# SparkPost replaces the local part with an id of its own, so bounces@bounce.example.com
# comes back as <id>@bounce.example.com. And a domain the account is not configured for is
# discarded silently: SparkPost sends the message anyway, under the fallback above.
#
# Discarded is about SparkPost, not about delivery. The fallback aligns with nothing, so
# DMARC then rests on DKIM alone - and a bogus value here has been observed to produce an
# accepted transmission that never arrived, with the same send under a configured domain
# delivering minutes later. Inert at the API, and still capable of losing the message.
#
# For DMARC to pass on SPF, this domain also has to align with the header From in
# SPARKPOST_FROM - so bounces@example.com against a From of noreply@example.com aligns,
# and the same address against a From on another domain authenticates but does not align.
# That is the reason to set one: an aligned bounce domain is a second route to a DMARC
# pass, while every fallback above aligns with nothing and leaves DMARC on DKIM alone.
#
# send.php sets it with SparkPostEmail::setSparkPostReturnPath(), which is the
# transmission field. Email::returnPath() is a different thing - it sets the MIME header -
# and setting that one instead leaves the account's default bounce domain on the envelope.
SPARKPOST_RETURN_PATH=

# Optional. Set to eu for the EU tenancy.
SPARKPOST_REGION=

# Set to exactly 1 to deliver to real addresses. Anything else, including empty, routes
# every recipient through SparkPost's sink, which accepts and discards it.
#
# Sink is the default on purpose. The failure it guards against is a session that does not
# know this file exists running an exercise "to see what it does" - and a session that does
# not know about the .env does not know about a flag either, so an opt-in sink would
# protect only the people who never needed it.
#
# Claude Code sessions cannot deliver at all: the exercises refuse when CLAUDECODE is set
# in the environment, whatever this file says, because a .env that permanently says
# DELIVER=1 is exactly how an agent sends real mail believing it is sinking. An agent that
# has been asked to send for real sets SPARKPOST_AGENT_MAY_DELIVER=1 as well.
#
# hampel/sparkpost uses the same variable with the same meaning.
SPARKPOST_DELIVER=
