# A SparkPost API key with the "Transmissions: Read/Write" permission.
SPARKPOST_API_KEY=

# Where the test message goes.
SPARKPOST_TO=you@example.com

# Who it comes from. This must be a verified sending domain on the account - or leave it
# on sparkpostbox.com, SparkPost's sandbox domain, which needs no verification but is
# limited to a handful of messages and requires the sandbox option (send.php sets it).
SPARKPOST_FROM=test@sparkpostbox.com

# Optional. Set to eu for the EU tenancy.
SPARKPOST_REGION=

# Set to 1 to route everything through SparkPost's sink instead of delivering it.
SPARKPOST_SINK=
